import { LibraryPage } from "../components/library-page.slint";
import { SongInfo } from "../components/song-row.slint";
import { Format } from "../format.slint";

//one artist, opened from "View artist" or from a Top Artist tile on the profile page.
//a tall banner with the artist's name, then play / shuffle and the song list.
export component ArtistView inherits Rectangle {
    in property <string> name;
    in property <image> art;               //picture of the artist, or the album art of one of the songs. empty = gradient
    in property <[SongInfo]> songs;
    in property <float> total-seconds;
    callback song-clicked(int);
    callback play-clicked();
    callback shuffle-clicked();
    callback sort-changed(int);
    callback song-action(int, string);

    LibraryPage {
        banner: true;
        name: root.name;
        banner-art: root.art;
        subtitle: Format.songs(root.songs.length, root.total-seconds);
        show-search: false;
        list-id: "artist";
        songs: root.songs;
        empty-text: "No songs by this artist in your library";

        song-clicked(i) => { root.song-clicked(i); }
        play-clicked => { root.play-clicked(); }
        shuffle-clicked => { root.shuffle-clicked(); }
        sort-changed(i) => { root.sort-changed(i); }
        song-action(i, id) => { root.song-action(i, id); }
    }
}
