//main screen after login is successful
//This file only connects the components to AppState, there is no data or logic in here.
import { Theme } from "../theme.slint";
import { AppState } from "../state.slint";
import { PlayerBar } from "../components/player-bar.slint";
import { SideNav, NavSection } from "../components/side-nav.slint";
import { TopBar } from "../components/top-bar.slint";
import { MockBackend } from "../components/mock-backend.slint";
import { HomeView } from "home-view.slint";
import { SongsView } from "songs-view.slint";
import { FavoritesView } from "favorites-view.slint";
import { RecordingsView } from "recordings-view.slint";
import { PlaylistView } from "playlist-view.slint";

export component AppShell inherits Rectangle {
    background: Theme.primary;

    //sidebar and content sit above the player bar
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - Theme.player-bar-height;

        side-nav := SideNav {
            x: 0px;
            y: 0px;
            height: parent.height;

            section <=> AppState.section;
            selected-playlist <=> AppState.selected-playlist;
            songs-count: AppState.songs-count;
            favorites-count: AppState.favorites-count;
            recordings-count: AppState.recordings-count;
            playlists: AppState.playlists;

            section-changed(s) => { AppState.section-changed(s); }
            playlist-clicked(i) => { AppState.playlist-clicked(i); }
            add-playlist => { AppState.add-playlist(); }
        }

        //pages go inside this panel
        Rectangle {
            x: side-nav.width;
            y: Theme.top-bar-height + 2 * Theme.top-bar-margin;
            width: parent.width - side-nav.width;
            height: parent.height + 6px - self.y;
            background: Theme.background;

            //control which page to show
            //home view
            if AppState.section == NavSection.home && AppState.selected-playlist < 0 : HomeView {
                recent: AppState.recent;
                most-played: AppState.most-played;
                recently-added: AppState.recently-added;

                show-all(which) => { AppState.show-all(which); }
                track-clicked(t) => { AppState.track-clicked(t); }
            }

            //all songs view
            if AppState.section == NavSection.songs && AppState.selected-playlist < 0 : SongsView {
                songs: AppState.songs;
                total-seconds: AppState.songs-seconds;

                song-clicked(i) => { AppState.song-clicked("songs", i); }
                play-clicked => { AppState.play-list("songs"); }
                shuffle-clicked => { AppState.shuffle-list("songs"); }
                search-edited(t) => { AppState.list-search-changed("songs", t); }
                sort-changed(i) => { AppState.list-sort-changed("songs", i); }
                add-folder => { AppState.add-folder(); }
            }

            //favorites view
            if AppState.section == NavSection.favorites && AppState.selected-playlist < 0 : FavoritesView {
                songs: AppState.favorites;
                total-seconds: AppState.favorites-seconds;

                song-clicked(i) => { AppState.song-clicked("favorites", i); }
                play-clicked => { AppState.play-list("favorites"); }
                shuffle-clicked => { AppState.shuffle-list("favorites"); }
                search-edited(t) => { AppState.list-search-changed("favorites", t); }
                sort-changed(i) => { AppState.list-sort-changed("favorites", i); }
            }

            //recordings view
            if AppState.section == NavSection.recordings && AppState.selected-playlist < 0 : RecordingsView {
                recordings: AppState.recordings;

                song-clicked(i) => { AppState.song-clicked("recordings", i); }
                start-recording => { AppState.start-recording(); }
                search-edited(t) => { AppState.list-search-changed("recordings", t); }
                sort-changed(i) => { AppState.list-sort-changed("recordings", i); }
            }

            //playlist view, opened from the sidebar
            if AppState.selected-playlist >= 0 : PlaylistView {
                title: AppState.playlists[AppState.selected-playlist].title;
                art: AppState.playlists[AppState.selected-playlist].art;
                songs: AppState.playlist-songs;
                total-seconds: AppState.playlist-seconds;

                song-clicked(i) => { AppState.song-clicked("playlist", i); }
                play-clicked => { AppState.play-list("playlist"); }
                shuffle-clicked => { AppState.shuffle-list("playlist"); }
                search-edited(t) => { AppState.list-search-changed("playlist", t); }
                edit-art-clicked => { AppState.edit-playlist-art(AppState.selected-playlist); }
                sort-changed(i) => { AppState.list-sort-changed("playlist", i); }
                browse-songs => {
                    AppState.selected-playlist = -1;
                    AppState.section = NavSection.songs;
                    AppState.section-changed(NavSection.songs);
                }
            }
        }

        top-bar := TopBar {
            x: side-nav.width + Theme.top-bar-margin;
            y: Theme.top-bar-margin;
            width: parent.width - side-nav.width - 2 * Theme.top-bar-margin;

            search-text <=> AppState.search-text;
            profile-initial: AppState.profile-initial;
            profile-picture: AppState.profile-picture;
            home-active: AppState.section == NavSection.home && AppState.selected-playlist < 0;

            home-clicked => {
                AppState.selected-playlist = -1;
                AppState.section = NavSection.home;
                AppState.section-changed(NavSection.home);
            }
            search-edited(t) => { AppState.search-changed(t); }
            search-submitted(t) => { AppState.search-submitted(t); }
            profile-clicked => { AppState.profile-clicked(); }
        }
    }

    PlayerBar {
        title: AppState.title;
        artist: AppState.artist;
        cover-art: AppState.cover-art;
        position: AppState.position;
        duration: AppState.duration;

        playing <=> AppState.playing;
        shuffle <=> AppState.shuffle;
        repeat <=> AppState.repeat;
        volume <=> AppState.volume;
        lyrics-open <=> AppState.lyrics-open;
        queue-open <=> AppState.queue-open;
        fullscreen <=> AppState.fullscreen;

        toggle-play => { AppState.toggle-play(); }
        previous => { AppState.previous(); }
        next => { AppState.next(); }
        seek(s) => { AppState.seek(s); }
        volume-changed(v) => { AppState.volume-changed(v); }
        shuffle-toggled(on) => { AppState.shuffle-toggled(on); }
        repeat-toggled(on) => { AppState.repeat-toggled(on); }
        lyrics-clicked => { AppState.lyrics-toggled(AppState.lyrics-open); }
        queue-clicked => { AppState.queue-toggled(AppState.queue-open); }
        add-clicked => { AppState.add-current-track(); }

        playlist-choices: AppState.playlist-choices;
        saved: AppState.track-saved-in > 0 || AppState.current-favorite;
        favorited <=> AppState.current-favorite;
        favorite-toggled(on) => { AppState.favorite-toggled(on); }
        playlist-toggled(i) => { AppState.playlist-toggled(i); }
        new-playlist => { AppState.new-playlist-from-track(); }
        playlist-search(t) => { AppState.playlist-picker-search(t); }
    }

    MockBackend {}
}
