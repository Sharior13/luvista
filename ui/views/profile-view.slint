import { Theme } from "../theme.slint";
import { PageScroll } from "../components/page-scroll.slint";
import { ArtistInfo, ArtistTile } from "../components/artist-tile.slint";
import { MenuPanel, MenuRow, MenuDivider } from "../components/menu.slint";
import { Format } from "../format.slint";
import { SongInfo, SongRow } from "../components/song-row.slint";
import { SongTableHeader } from "../components/song-table-header.slint";

//profile page: name and picture, a settings button, a "..." menu and the Top Artist row.
//clicking an artist opens that artist's page.
export component ProfileView inherits Rectangle {
    in property <string> name;
    in property <image> picture;              //empty = gradient with a heart
    in property <int> playlist-count;
    in property <int> song-count;
    in property <[ArtistInfo]> top-artists;
    in property <[SongInfo]> top-songs;       //most played songs, most played first
    callback settings-clicked();
    callback edit-clicked();                  //"Edit profile" in the "..." menu
    callback picture-clicked();               //click on the picture, or "Change picture"
    callback logout-clicked();
    callback artist-clicked(int);             //index into top-artists
    callback top-song-clicked(int);           //index into top-songs
    callback show-most-played();              //"Show all" next to Most Played

    property <bool> compact: root.width < Theme.bp-date;
    property <bool> narrow: root.width < 470px;                        //picture and name stack on top of each other
    property <bool> show-album: root.width >= Theme.bp-album;
    property <length> tile-gap: 12px;
    //artist tiles wrap onto more rows instead of running off the right edge
    property <int> tile-columns: Math.max(1, Math.floor((root.width - 2 * root.pad + root.tile-gap) / (118px + root.tile-gap)));
    property <int> tile-rows: Math.ceil(root.top-artists.length / root.tile-columns);
    property <length> pad: root.compact ? 20px : 36px;
    property <length> art-size: root.compact ? 88px : 112px;
    property <bool> has-picture: root.picture.width > 0 && root.picture.height > 0;

    PageScroll {
        VerticalLayout {
            spacing: 0px;

            //page title
            Rectangle {
                height: root.compact ? 76px : 96px;

                Text {
                    x: root.pad;
                    width: parent.width - 2 * root.pad;
                    height: parent.height;
                    text: "Profile";
                    color: Theme.text-primary;
                    font-size: root.compact ? 34px : 44px;
                    font-weight: 800;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            //band: picture, name and the playlist / song count
            Rectangle {
                height: root.narrow ? root.art-size + 24px + 76px : root.art-size + 24px;
                background: Theme.header-band;

                pic := Rectangle {
                    x: root.narrow ? (parent.width - self.width) / 2 : root.pad;
                    y: root.narrow ? 12px : (parent.height - self.height) / 2;
                    width: root.art-size;
                    height: root.art-size;
                    border-radius: 8px;
                    clip: true;
                    background: Theme.art-gradient;

                    if !root.has-picture : Image {
                        source: @image-url("../icons/heart.svg");
                        colorize: Theme.text-primary;
                        width: parent.width * 0.55;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    if root.has-picture : Image {
                        source: root.picture;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }

                    //dark wash with a camera while hovered: click to change the picture
                    Rectangle {
                        background: cover-touch.has-hover ? #000000a6 : transparent;
                        animate background { duration: Theme.anim-fast; }
                    }
                    if cover-touch.has-hover : Image {
                        source: @image-url("../icons/camera.svg");
                        colorize: Theme.text-primary;
                        width: parent.width * 0.36;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    cover-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.picture-clicked(); }
                    }
                }

                VerticalLayout {
                    x: root.narrow ? root.pad : pic.x + pic.width + 20px;
                    y: root.narrow ? pic.y + pic.height + 8px : 0px;
                    width: max(0px, parent.width - self.x - root.pad);
                    height: root.narrow ? 64px : parent.height;
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: root.name;
                        color: Theme.text-primary;
                        font-size: root.narrow ? 26px : (root.compact ? 30px : 44px);
                        font-weight: 800;
                        horizontal-alignment: root.narrow ? center : left;
                        overflow: elide;
                    }
                    Text {
                        text: Format.profile(root.playlist-count, root.song-count);
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: root.narrow ? center : left;
                        overflow: elide;
                    }
                }
            }

            //toolbar: settings gear and "..." menu
            Rectangle {
                height: 64px;

                gear := Rectangle {
                    x: root.pad;
                    y: (parent.height - self.height) / 2;
                    width: 44px;
                    height: 44px;
                    border-radius: self.width / 2;
                    background: gear-touch.has-hover ? Theme.nav-hover : transparent;

                    gear-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.settings-clicked(); }
                    }
                    Image {
                        source: @image-url("../icons/settings.svg");
                        colorize: gear-touch.has-hover ? Theme.text-primary : Theme.control-muted;
                        width: 26px;
                        height: 26px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                dots := Rectangle {
                    x: gear.x + gear.width + 8px;
                    y: (parent.height - self.height) / 2;
                    width: 44px;
                    height: 44px;
                    border-radius: self.width / 2;
                    background: dots-touch.has-hover ? Theme.nav-hover : transparent;

                    dots-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { menu.show(); }
                    }
                    Image {
                        source: @image-url("../icons/more.svg");
                        colorize: dots-touch.has-hover ? Theme.text-primary : Theme.control-muted;
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    menu := PopupWindow {
                        x: 0px;
                        y: parent.height + 4px;
                        width: 230px;
                        height: 4 * Theme.menu-row-height + 9px + 12px;
                        close-policy: PopupClosePolicy.close-on-click-outside;

                        MenuPanel {
                            MenuRow {
                                icon: @image-url("../icons/edit.svg");
                                label: "Edit profile";
                                clicked => { root.edit-clicked(); menu.close(); }
                            }
                            MenuRow {
                                icon: @image-url("../icons/camera.svg");
                                label: "Change picture";
                                clicked => { root.picture-clicked(); menu.close(); }
                            }
                            MenuRow {
                                icon: @image-url("../icons/settings.svg");
                                label: "Settings";
                                clicked => { root.settings-clicked(); menu.close(); }
                            }
                            MenuDivider { }
                            MenuRow {
                                icon: @image-url("../icons/logout.svg");
                                label: "Log out";
                                clicked => { root.logout-clicked(); menu.close(); }
                            }
                        }
                    }
                }
            }

            //most played songs
            Rectangle {
                height: 40px;

                Text {
                    x: root.pad;
                    width: parent.width - 2 * root.pad - 90px;
                    height: parent.height;
                    text: "Most Played";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 800;
                    vertical-alignment: center;
                }

                if root.top-songs.length > 0 : Rectangle {
                    x: parent.width - self.width - root.pad;
                    width: 80px;

                    Text {
                        text: "Show all";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        opacity: all-touch.has-hover ? 1.0 : 0.85;
                    }
                    all-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.show-most-played(); }
                    }
                }
            }

            if root.top-songs.length == 0 : Rectangle {
                height: 64px;
                Text {
                    x: root.pad;
                    width: parent.width - 2 * root.pad;
                    height: parent.height;
                    text: "Nothing played yet. Your most played songs will show up here";
                    color: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if root.top-songs.length > 0 : VerticalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                spacing: 2px;

                SongTableHeader {
                    show-album: root.show-album;
                    show-date: false;
                    show-more: false;
                    length-label: "Length";
                }

                for s[i] in root.top-songs : SongRow {
                    index: i;
                    song: s;
                    show-album: root.show-album;
                    show-date: false;
                    show-more: false;
                    context: "most-played";
                    clicked(ctrl, shift) => { root.top-song-clicked(i); }
                }
            }

            Rectangle { height: 24px; }

            //top artists
            Rectangle {
                height: 40px;
                Text {
                    x: root.pad;
                    width: parent.width - 2 * root.pad;
                    height: parent.height;
                    text: "Top Artist";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
            }

            if root.top-artists.length == 0 : Rectangle {
                height: 64px;
                Text {
                    x: root.pad;
                    width: parent.width - 2 * root.pad;
                    height: parent.height;
                    text: "No top artists yet. Play some music and they will show up here";
                    color: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            //tiles, as many to a row as fit
            if root.top-artists.length > 0 : Rectangle {
                height: root.tile-rows * (150px + root.tile-gap);

                for a[i] in root.top-artists : ArtistTile {
                    x: root.pad - 8px + Math.mod(i, root.tile-columns) * (118px + root.tile-gap);
                    y: Math.floor(i / root.tile-columns) * (150px + root.tile-gap);
                    artist: a;
                    clicked => { root.artist-clicked(i); }
                }
            }

            Rectangle { height: 40px; }
        }
    }
}
