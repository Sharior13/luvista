import { Theme } from "../theme.slint";
import { PageScroll } from "../components/page-scroll.slint";
import { Dropdown } from "../components/dropdown.slint";
import { ToggleSwitch } from "../components/toggle-switch.slint";
import { PillButton } from "../components/pill-button.slint";
import { DialogButton, ButtonKind } from "../components/dialog-frame.slint";

//one music folder of the library
export struct MusicFolderInfo {
    path: string,
    is-default: bool,       //the user's Music folder: always there, cannot be removed
}

//one line of the settings card: name on the left, whatever controls it on the right
component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;            //small grey text under the label
    in property <bool> last: false;       //no divider under the last row

    height: 60px;

    @children

    Text {
        x: 24px;
        y: root.hint == "" ? 0px : 10px;
        width: max(0px, parent.width / 2 - 24px);
        height: root.hint == "" ? parent.height : 24px;
        text: root.label;
        color: Theme.control-muted;
        font-size: 16px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.hint != "" : Text {
        x: 24px;
        y: 32px;
        width: max(0px, parent.width / 2 - 24px);
        height: 18px;
        text: root.hint;
        color: Theme.text-muted;
        font-size: 12px;
        font-weight: 700;
        overflow: elide;
    }
    if !root.last : Rectangle {
        x: 24px;
        y: parent.height - 1px;
        width: parent.width - 48px;
        height: 1px;
        background: #ffffff14;
    }
}

//one folder of the list: its address on the left, "Default" or a remove icon on the right
component FolderRow inherits Rectangle {
    in property <string> path;
    in property <bool> is-default;
    in property <bool> last: false;
    callback remove();

    height: 52px;

    Text {
        x: 24px;
        width: max(0px, parent.width - 48px - (root.is-default ? 80px : 40px));
        height: parent.height;
        text: root.path;
        color: Theme.control-muted;
        font-size: 14px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.is-default : Rectangle {
        x: parent.width - self.width - 24px;
        y: (parent.height - self.height) / 2;
        width: 64px;
        height: 24px;
        border-radius: 12px;
        background: #ffffff14;

        Text {
            text: "Default";
            color: Theme.text-muted;
            font-size: 12px;
            font-weight: 800;
        }
    }

    if !root.is-default : Rectangle {
        x: parent.width - self.width - 20px;
        y: (parent.height - self.height) / 2;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: remove-touch.has-hover ? #ffffff1f : transparent;

        Image {
            width: 18px;
            height: 18px;
            source: @image-url("../icons/trash.svg");
            colorize: Theme.control-muted;
        }

        remove-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.remove(); }
        }
    }

    if !root.last : Rectangle {
        x: 24px;
        y: parent.height - 1px;
        width: parent.width - 48px;
        height: 1px;
        background: #ffffff14;
    }
}

//settings page: account, language, autoplay, music folders and theme. The backend owns the values.
export component SettingsView inherits Rectangle {
    in property <string> account-name;
    in property <string> storage-text;               //e.g. "128 songs in 2 folders"
    in property <[MusicFolderInfo]> music-folders;   //the default folder first
    in property <string> folder-error;               //why the last add/remove did not work, empty = fine
    in property <[string]> languages: ["English"];
    in property <[string]> themes: ["Default"];
    in-out property <int> language-index: 0;
    in-out property <int> theme-index: 0;
    in-out property <bool> autoplay: false;
    in-out property <bool> open-last-profile: true;
    in property <int> removed-count: 0;
    callback account-edit();
    callback language-changed(int);
    callback autoplay-toggled(bool);
    callback add-folder();
    callback remove-folder(int);
    callback theme-changed(int);
    callback logout-clicked();
    callback open-last-profile-toggled(bool);
    callback manage-removed();

    property <bool> compact: root.width < Theme.bp-date;
    property <length> pad: root.compact ? 20px : 36px;

    PageScroll {
        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: root.compact ? 76px : 96px;

                Text {
                    x: root.pad;
                    width: parent.width - 2 * root.pad;
                    height: parent.height;
                    text: "Settings";
                    color: Theme.text-primary;
                    font-size: root.compact ? 34px : 44px;
                    font-weight: 800;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            Rectangle {
                height: 6 * 60px + 24px + 24px;

                card := Rectangle {
                    x: root.pad;
                    y: 0px;
                    width: parent.width - 2 * root.pad;
                    height: 6 * 60px + 24px;
                    border-radius: 16px;
                    background: Theme.settings-card;

                    VerticalLayout {
                        padding-top: 12px;
                        padding-bottom: 12px;

                        //account
                        SettingsRow {
                            label: "Account";
                            hint: root.account-name;

                            PillButton {
                                x: parent.width - self.width - 24px;
                                y: (parent.height - self.height) / 2;
                                label: "Edit";
                                icon: @image-url("../icons/edit.svg");
                                clicked => { root.account-edit(); }
                            }
                        }

                        //language
                        SettingsRow {
                            label: "Language";

                            Dropdown {
                                x: parent.width - self.width - 24px;
                                y: (parent.height - self.height) / 2;
                                options: root.languages;
                                selected <=> root.language-index;
                                chosen(i) => { root.language-changed(i); }
                            }
                        }

                        //autoplay: keep playing similar songs when the queue ends
                        SettingsRow {
                            label: "Autoplay";
                            hint: "Keep playing when the queue runs out";

                            ToggleSwitch {
                                x: parent.width - self.width - 24px;
                                y: (parent.height - self.height) / 2;
                                checked <=> root.autoplay;
                                toggled(on) => { root.autoplay-toggled(on); }
                            }
                        }

                        //removed songs: the ones taken out of the library on purpose, with a way to bring them back
                        SettingsRow {
                            label: "Removed songs";
                            hint: root.removed-count == 0 ? "No songs removed" : (root.removed-count == 1 ? "1 song removed" : "\{root.removed-count} songs removed");

                            PillButton {
                                x: parent.width - self.width - 24px;
                                y: (parent.height - self.height) / 2;
                                label: "Manage";
                                icon: @image-url("../icons/trash.svg");
                                clicked => { root.manage-removed(); }
                            }
                        }

                        //open the profile that was used last when the app starts
                        SettingsRow {
                            label: "Open last profile";
                            hint: "Skip the login screen when the app starts";

                            ToggleSwitch {
                                x: parent.width - self.width - 24px;
                                y: (parent.height - self.height) / 2;
                                checked <=> root.open-last-profile;
                                toggled(on) => { root.open-last-profile-toggled(on); }
                            }
                        }

                        //themes
                        SettingsRow {
                            label: "Themes";
                            last: true;

                            Dropdown {
                                x: parent.width - self.width - 24px;
                                y: (parent.height - self.height) / 2;
                                options: root.themes;
                                selected <=> root.theme-index;
                                chosen(i) => { root.theme-changed(i); }
                            }
                        }
                    }
                }
            }

            //music folders: where the songs are read from
            Rectangle {
                height: 24px + 60px + root.music-folders.length * 52px + (root.folder-error == "" ? 0px : 32px) + 24px;

                Rectangle {
                    x: root.pad;
                    y: 0px;
                    width: parent.width - 2 * root.pad;
                    height: 24px + 60px + root.music-folders.length * 52px;
                    border-radius: 16px;
                    background: Theme.settings-card;

                    VerticalLayout {
                        padding-top: 12px;
                        padding-bottom: 12px;

                        SettingsRow {
                            label: "Music folders";
                            hint: root.storage-text;
                            last: root.music-folders.length == 0;

                            PillButton {
                                x: parent.width - self.width - 24px;
                                y: (parent.height - self.height) / 2;
                                label: "Add folder";
                                icon: @image-url("../icons/folder.svg");
                                clicked => { root.add-folder(); }
                            }
                        }

                        for folder[i] in root.music-folders : FolderRow {
                            path: folder.path;
                            is-default: folder.is-default;
                            last: i == root.music-folders.length - 1;
                            remove => { root.remove-folder(i); }
                        }
                    }
                }

                if root.folder-error != "" : Text {
                    x: root.pad + 8px;
                    y: 24px + 60px + root.music-folders.length * 52px + 12px;
                    width: parent.width - 2 * root.pad - 16px;
                    height: 20px;
                    text: root.folder-error;
                    color: #ff8a9b;
                    font-size: 13px;
                    font-weight: 700;
                    overflow: elide;
                }
            }

            //keyboard shortcuts
            Rectangle {
                height: 6 * 28px + 64px;

                Rectangle {
                    x: root.pad;
                    width: parent.width - 2 * root.pad;
                    height: parent.height - 16px;
                    border-radius: 16px;
                    background: Theme.settings-card;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 0px;

                        Text {
                            height: 32px;
                            text: "Keyboard shortcuts";
                            color: Theme.text-primary;
                            font-size: 16px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        for line in [
                            "Space  play / pause",
                            "N / B  next / previous song",
                            "Left / Right  back / forward 5 seconds",
                            "Up / Down  volume   M  mute",
                            "S  shuffle   R  repeat   L  lyrics   Q  queue",
                            "F or F11  fullscreen   Esc  leave fullscreen or selecting"
                        ] : Text {
                            height: 28px;
                            text: line;
                            color: Theme.text-muted;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            Rectangle {
                height: 80px;

                DialogButton {
                    x: root.pad;
                    y: 20px;
                    label: "Log out";
                    icon: @image-url("../icons/logout.svg");
                    kind: ButtonKind.secondary;
                    clicked => { root.logout-clicked(); }
                }
            }

            Rectangle { height: 40px; }
        }
    }
}
