//small text helpers for the page headers ("3 songs, 10.4 mins")
export global Format {
    //10.4, or just 3 when there is no decimal part
    pure public function minutes(seconds: float) -> string {
        if (Math.mod(Math.round(seconds / 6), 10) == 0) {
            return "\{Math.round(seconds / 60)}";
        }
        return "\{Math.floor(Math.round(seconds / 6) / 10)}.\{Math.mod(Math.round(seconds / 6), 10)}";
    }

    pure public function songs(count: int, seconds: float) -> string {
        if (count == 1) {
            return "1 song, \{minutes(seconds)} mins";
        }
        return "\{count} songs, \{minutes(seconds)} mins";
    }

    pure public function recordings(count: int) -> string {
        if (count == 1) {
            return "1 Recording";
        }
        return "\{count} Recordings";
    }

    //"3 Playlists, 12 Songs" under the name on the profile page
    pure public function profile(playlists: int, songs: int) -> string {
        return (playlists == 1 ? "1 Playlist" : "\{playlists} Playlists") + ", " + (songs == 1 ? "1 Song" : "\{songs} Songs");
    }

    //07 instead of 7
    pure function two(n: int) -> string {
        return n < 10 ? "0\{n}" : "\{n}";
    }

    //1:05 style clock for the recorder, 00:07 / 12:30
    pure public function clock(seconds: float) -> string {
        return two(Math.floor(seconds / 60)) + ":" + two(Math.mod(Math.floor(seconds), 60));
    }
}
