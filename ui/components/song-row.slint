import { Theme } from "../theme.slint";
import { CoverArt } from "cover-art.slint";
import { SongMenu } from "song-menu.slint";

//one song in a list. The backend formats date-added and length as text.
export struct SongInfo {
    title: string,
    artist: string,
    album: string,         //empty shows "-"
    date-added: string,    //"yesterday", "2 weeks"
    length: string,        //"3:22"
    art: image,            //album art, empty = gradient placeholder
    favorite: bool,        //the song is a favorite (the "..." menu offers Add / Remove)
    queued: bool,          //the song is in the queue (the "..." menu offers Remove from queue)
}

//one row of a song list: number, art + title/artist, album, date added and length.
export component SongRow inherits Rectangle {
    in property <int> index;               //0 based, shown as index + 1
    in property <SongInfo> song;
    in property <image> icon;              //drawn on top of the gradient when show-icon is true (recordings)
    in property <bool> show-icon: false;
    in property <bool> show-album: true;
    in property <bool> show-date: true;
    in property <bool> show-more: true;    //the "..." button at the end of the row
    in property <string> context: "songs"; //page the row is on, decides what the "..." menu offers
    callback clicked();
    callback action(string);               //an entry of the "..." menu, see song-menu.slint

    height: Theme.row-height;
    border-radius: 8px;
    property <bool> hot: touch.has-hover || menu.hovered;
    background: root.hot ? Theme.nav-hover : transparent;
    animate background { duration: Theme.anim-fast; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        //number, becomes a play icon while the row is hovered
        Rectangle {
            width: Theme.col-index;

            Text {
                visible: !root.hot;
                text: "\{root.index + 1}";
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Image {
                visible: root.hot;
                source: @image-url("../icons/play.svg");
                colorize: Theme.text-primary;
                width: 18px;
                height: 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        //art + title and artist
        Rectangle {
            horizontal-stretch: 1;

            CoverArt {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                border-radius: 6px;
                art: root.song.art;
                icon: root.icon;
                show-icon: root.show-icon;
                icon-scale: 0.55;
            }

            VerticalLayout {
                x: 52px;
                width: max(0px, parent.width - 52px - 12px);
                height: parent.height;
                alignment: center;
                spacing: 1px;

                Text {
                    text: root.song.title;
                    color: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.song.artist;
                    color: Theme.text-muted;
                    font-size: 13px;
                    font-weight: 700;
                    overflow: elide;
                }
            }
        }

        //album
        if root.show-album : Rectangle {
            width: Theme.col-album;
            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.song.album == "" ? "-" : root.song.album;
                color: Theme.text-primary;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        //date added
        if root.show-date : Rectangle {
            width: Theme.col-date;
            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.song.date-added;
                color: Theme.text-primary;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        //length
        Rectangle {
            width: Theme.col-length;
            Text {
                width: 100%;
                height: 100%;
                text: root.song.length;
                color: Theme.text-primary;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        //"..." menu
        menu := SongMenu {
            width: root.show-more ? Theme.col-more : 0px;
            visible: root.show-more;
            context: root.context;
            favorite: root.song.favorite;
            queued: root.song.queued;
            row-hover: touch.has-hover;
            action(id) => { root.action(id); }
        }
    }
}
