import { Theme } from "../theme.slint";
import { CoverArt } from "cover-art.slint";
import { SongMenu } from "song-menu.slint";
import { ClickText } from "click-text.slint";
import { Nav } from "../navigation.slint";

//one song in a list. The backend formats date-added and length as text.
export struct SongInfo {
    title: string,
    artist: string,
    album: string,         //empty shows "-"
    date-added: string,    //"yesterday", "2 weeks"
    length: string,        //"3:22"
    art: image,            //album art, empty = gradient placeholder
    favorite: bool,        //the song is a favorite (the "..." menu offers Add / Remove)
    queued: bool,          //the song is in the queue (the "..." menu offers Remove from queue)
    selected: bool,        //ticked while several songs are being selected
}

//one row of a song list: number, art + title/artist, album, date added and length.
export component SongRow inherits Rectangle {
    in property <int> index;               //0 based, shown as index + 1
    in property <SongInfo> song;
    in property <image> icon;              //drawn on top of the gradient when show-icon is true (recordings)
    in property <bool> show-icon: false;
    in property <bool> show-album: true;
    in property <bool> show-date: true;
    in property <bool> show-more: true;    //the "..." button at the end of the row
    in property <bool> select-mode: false; //a tick box takes the place of the number
    in property <bool> links: true;        //artist and album are clickable (not for recordings)
    in property <string> context: "songs"; //page the row is on, decides what the "..." menu offers
    callback clicked(bool, bool);          //ctrl held, shift held
    callback action(string);               //an entry of the "..." menu, see song-menu.slint

    height: Theme.row-height;
    border-radius: 8px;
    property <bool> hot: touch.has-hover || menu.hovered;
    background: root.song.selected ? #ffffff2e : (root.hot ? Theme.nav-hover : transparent);
    animate background { duration: Theme.anim-fast; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        //a click is the button going up while the mouse is still on the row, so ctrl and shift can be read
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && self.has-hover) {
                root.clicked(e.modifiers.control, e.modifiers.shift);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        //number, becomes a play icon while the row is hovered
        Rectangle {
            width: Theme.col-index;

            Text {
                visible: !root.hot && !root.select-mode;
                text: "\{root.index + 1}";
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            //tick box while selecting
            Rectangle {
                visible: root.select-mode;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                border-radius: 4px;
                background: root.song.selected ? Theme.toggle-on : transparent;
                border-width: root.song.selected ? 0px : 2px;
                border-color: Theme.control-muted;

                if root.song.selected : Image {
                    source: @image-url("../icons/check.svg");
                    colorize: Theme.text-primary;
                    width: 14px;
                    height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            Image {
                visible: root.hot && !root.select-mode;
                source: @image-url("../icons/play.svg");
                colorize: Theme.text-primary;
                width: 18px;
                height: 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        //art + title and artist
        Rectangle {
            horizontal-stretch: 1;

            CoverArt {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                border-radius: 6px;
                art: root.song.art;
                icon: root.icon;
                show-icon: root.show-icon;
                icon-scale: 0.55;
            }

            VerticalLayout {
                x: 52px;
                width: max(0px, parent.width - 52px - 12px);
                height: parent.height;
                alignment: center;
                spacing: 1px;

                Text {
                    text: root.song.title;
                    color: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                HorizontalLayout {
                    alignment: start;

                    ClickText {
                        text: root.song.artist;
                        tint: Theme.text-muted;
                        font-size: 13px;
                        enabled: root.links && root.song.artist != "" && root.song.artist != "Unknown artist";
                        clicked => { Nav.open-artist(root.song.artist); }
                    }
                }
            }
        }

        //album
        if root.show-album : Rectangle {
            width: Theme.col-album;
            HorizontalLayout {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                alignment: center;

                ClickText {
                    text: root.song.album == "" ? "-" : root.song.album;
                    tint: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 400;
                    enabled: root.links && root.song.album != "" && root.song.album != "Unknown album";
                    clicked => { Nav.open-album(root.song.album); }
                }
            }
        }

        //date added
        if root.show-date : Rectangle {
            width: Theme.col-date;
            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.song.date-added;
                color: Theme.text-primary;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        //length
        Rectangle {
            width: Theme.col-length;
            Text {
                width: 100%;
                height: 100%;
                text: root.song.length;
                color: Theme.text-primary;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        //"..." menu
        menu := SongMenu {
            width: root.show-more ? Theme.col-more : 0px;
            visible: root.show-more;
            context: root.context;
            favorite: root.song.favorite;
            queued: root.song.queued;
            row-hover: touch.has-hover;
            action(id) => { root.action(id); }
        }
    }
}
