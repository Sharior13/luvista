import { Theme } from "../theme.slint";

//the "# Title Album Date added Length" line above a song list.
//it uses the same column widths as SongRow so everything lines up.
export component SongTableHeader inherits Rectangle {
    in property <bool> show-album: true;
    in property <bool> show-date: true;
    in property <string> length-label: "Length";

    height: 40px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Rectangle {
            width: Theme.col-index;
            Text {
                width: 100%;
                height: 100%;
                text: "#";
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            Text {
                width: 100%;
                height: 100%;
                text: "Title";
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        if root.show-album : Rectangle {
            width: Theme.col-album;
            Text {
                width: 100%;
                height: 100%;
                text: "Album";
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.show-date : Rectangle {
            width: Theme.col-date;
            Text {
                width: 100%;
                height: 100%;
                text: "Date added";
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: Theme.col-length;
            Text {
                width: 100%;
                height: 100%;
                text: root.length-label;
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
