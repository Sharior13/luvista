import { Theme } from "../theme.slint";
import { SearchField } from "search-field.slint";
import { PageScroll } from "page-scroll.slint";

//one playlist in the "Add to playlist" popup
//order the list so playlists with saved: true come first, the popup puts the section titles in by itself
export struct PlaylistChoice {
    title: string,
    art: image,            //empty = gradient placeholder
    count: int,            //number of songs, shown as "538 songs"
    saved: bool,           //the track was already in it when the popup was opened ("Saved in" section)
    checked: bool,         //the track is in it right now, flips when the row is clicked
}

//round tick on the right of a row, filled and ticked when checked
component Tick inherits Rectangle {
    in property <bool> checked;

    width: 22px;
    height: 22px;
    border-radius: self.width / 2;
    border-width: root.checked ? 0px : 2px;
    border-color: Theme.control-muted;
    background: root.checked ? Theme.pink : transparent;
    animate background { duration: Theme.anim-fast; }

    if root.checked : Image {
        source: @image-url("../icons/check.svg");
        colorize: Theme.primary;
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

//icon + label row ("Add to Favorites", "New playlist"), with an optional tick
component ActionRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <color> tint: Theme.text-primary;
    in property <bool> show-tick: false;
    in property <bool> checked;
    callback clicked();

    height: 48px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.nav-hover : transparent;
    animate background { duration: Theme.anim-fast; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    Image {
        source: root.icon;
        colorize: root.tint;
        width: 22px;
        height: 22px;
        x: 12px;
        y: (parent.height - self.height) / 2;
    }
    Text {
        x: 12px + 22px + 14px;
        width: max(0px, parent.width - self.x - 50px);
        height: parent.height;
        text: root.label;
        color: Theme.text-primary;
        font-size: 16px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.show-tick : Tick {
        x: parent.width - self.width - 12px;
        y: (parent.height - self.height) / 2;
        checked: root.checked;
    }
}

//playlist row: cover, name, song count and a tick
component PlaylistRow inherits Rectangle {
    in property <string> title;
    in property <image> art;
    in property <int> count;
    in property <bool> checked;
    callback clicked();

    height: 64px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.nav-hover : transparent;
    animate background { duration: Theme.anim-fast; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    Rectangle {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 48px;
        height: 48px;
        border-radius: 6px;
        clip: true;
        background: @linear-gradient(135deg, Theme.playlist-art-start 0%, Theme.playlist-art-end 100%);

        Image {
            source: @image-url("../icons/playlist.svg");
            colorize: Theme.text-primary;
            width: 22px;
            height: 22px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            opacity: 0.85;
        }
        Image {
            source: root.art;
            width: 100%;
            height: 100%;
            image-fit: cover;
        }
    }

    VerticalLayout {
        x: 8px + 48px + 14px;
        width: max(0px, parent.width - self.x - 50px);
        height: parent.height;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: 16px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.count == 1 ? "1 song" : "\{root.count} songs";
            color: Theme.control-muted;
            font-size: 14px;
            font-weight: 700;
            overflow: elide;
        }
    }

    Tick {
        x: parent.width - self.width - 12px;
        y: (parent.height - self.height) / 2;
        checked: root.checked;
    }
}

//popup behind the "+" in the player bar
export component AddToPlaylistMenu inherits Rectangle {
    in property <[PlaylistChoice]> playlists;
    in-out property <bool> favorited;       //is the current track a favorite
    callback favorite-toggled(bool);
    callback playlist-toggled(int);         //index into playlists
    callback new-playlist();
    callback search-edited(string);         //text of the "Find a playlist" box, filter playlists and set them again

    public function open() { popup.show(); }

    popup := PopupWindow {
        x: 0px;
        y: -self.height - 8px;
        width: 340px;
        height: 460px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: Theme.primary;
            border-width: 1px;
            border-radius: 12px;
            border-color: Theme.accent;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 16px;
                spacing: 6px;

                Text {
                    text: "Add to playlist";
                    height: 22px;
                    color: Theme.control-muted;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                SearchField {
                    autofocus: true;
                    placeholder: "Find a playlist";
                    edited(t) => { root.search-edited(t); }
                }

                //favorites sits right under the search so it is always in reach
                ActionRow {
                    icon: @image-url("../icons/heart.svg");
                    label: "Add to Favorites";
                    tint: root.favorited ? Theme.pink : Theme.icon-dim;
                    show-tick: true;
                    checked: root.favorited;
                    clicked => {
                        root.favorited = !root.favorited;
                        root.favorite-toggled(root.favorited);
                    }
                }

                ActionRow {
                    icon: @image-url("../icons/plus.svg");
                    label: "New playlist";
                    clicked => {
                        popup.close();
                        root.new-playlist();
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.nav-hover;
                }

                PageScroll {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding-right: 14px;

                        for p[i] in root.playlists : VerticalLayout {
                            //section title above the first playlist of each group
                            if i == 0 || root.playlists[i - 1].saved != p.saved : Text {
                                text: p.saved ? "Saved in" : "Recently updated";
                                height: 36px;
                                x: 4px;
                                color: Theme.control-muted;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            PlaylistRow {
                                title: p.title;
                                art: p.art;
                                count: p.count;
                                checked: p.checked;
                                clicked => { root.playlist-toggled(i); }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.nav-hover;
                }

                //changes apply right away so this only closes the popup
                Rectangle {
                    height: 52px;

                    Text {
                        x: parent.width - self.width - 12px;
                        width: self.preferred-width;
                        height: parent.height;
                        text: "Done";
                        color: done-touch.has-hover ? Theme.text-primary : Theme.control-muted;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                        animate color { duration: Theme.anim-fast; }
                    }
                    done-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { popup.close(); }
                    }
                }
            }
        }
    }
}
