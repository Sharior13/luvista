import { Theme } from "../theme.slint";

//small dark pill showing the chosen option with a chevron. Click opens a list under it.
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected: 0;
    callback chosen(int);

    height: 34px;
    width: max(96px, 14px + label.preferred-width + 10px + 16px + 12px);
    border-radius: 6px;
    background: Theme.primary;

    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { popup.show(); }
    }

    label := Text {
        x: 14px;
        width: self.preferred-width;
        height: parent.height;
        text: root.options[root.selected];
        color: Theme.text-primary;
        font-size: 14px;
        font-weight: 800;
        vertical-alignment: center;
    }
    Image {
        source: @image-url("../icons/chevron-down.svg");
        colorize: Theme.text-primary;
        width: 16px;
        height: 16px;
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
    }

    popup := PopupWindow {
        x: root.width - self.width;
        y: root.height + 4px;
        width: max(root.width, 170px);
        height: root.options.length * 40px + 16px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: Theme.menu-bg;
            border-width: 1px;
            border-radius: 10px;
            border-color: Theme.menu-border;

            VerticalLayout {
                padding: 8px;

                for option[i] in root.options : Rectangle {
                    height: 40px;
                    border-radius: 6px;
                    background: option-touch.has-hover ? Theme.nav-hover : transparent;

                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: option;
                        color: i == root.selected ? Theme.pink : Theme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    option-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.selected = i;
                            root.chosen(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}
