import { Theme } from "../theme.slint";

//a labelled text field, used by the sign in / create profile screens and by the dialogs.
//grey box, light outline, purple outline while it has the cursor, red outline when invalid.
export component TextBox inherits Rectangle {
    in property <string> label;                 //empty = no label above the box
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;         //dots instead of letters
    in property <bool> invalid: false;
    in property <bool> autofocus: false;        //put the cursor in the box as soon as it appears
    callback edited(string);
    callback accepted(string);                  //Enter pressed

    public function focus-input() { input.focus(); }

    init => {
        if (root.autofocus) { input.focus(); }
    }

    height: (root.label == "" ? 0px : 22px) + 40px;

    if root.label != "" : Text {
        x: 2px;
        y: 0px;
        height: 18px;
        width: parent.width - 4px;
        text: root.label;
        color: Theme.text-primary;
        font-size: 12px;
        font-weight: 700;
        overflow: elide;
    }

    box := Rectangle {
        y: root.label == "" ? 0px : 22px;
        height: 40px;
        border-radius: 8px;
        background: Theme.field-bg;
        border-width: 2px;
        border-color: root.invalid ? Theme.danger : (input.has-focus ? Theme.field-focus : Theme.field-border);
        animate border-color { duration: Theme.anim-fast; }

        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }

        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            single-line: true;
            input-type: root.password ? InputType.password : InputType.text;
            color: Theme.text-primary;
            font-size: 15px;
            vertical-alignment: center;
            selection-background-color: Theme.pink;
            selection-foreground-color: Theme.primary;
            text <=> root.text;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }

        Text {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: root.placeholder;
            color: Theme.control-muted;
            font-size: 15px;
            vertical-alignment: center;
            overflow: elide;
            visible: input.text == "" && !root.password;
        }
    }
}
