import { Theme } from "../theme.slint";
import { BarSlider } from "bar-slider.slint";

//small icon button, only the icon area is clickable
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> glyph: 22px;
    in property <color> tint: Theme.icon-dim;
    callback clicked();

    width: root.glyph + 14px;

    Rectangle {
        width: root.glyph + 14px;
        height: root.glyph + 14px;
        y: (parent.height - self.height) / 2;

        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }

        Image {
            source: root.icon;
            colorize: root.tint;
            width: root.glyph;
            height: root.glyph;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            opacity: touch.has-hover ? 1.0 : 0.85;
        }
    }
}

export component PlayerBar inherits Rectangle {
    //fill available parent space
    width: 100%;
    height: 100%;

    //track info
    in property <string> title: "Slow Tide Home";
    in property <string> artist: "Marlo Vey";
    in property <image> cover-art;      //empty -> pink gradient circle

    //playback state, in seconds
    in property <float> position: 32;
    in property <float> duration: 214;

    //two-way so they work standalone and can be bound with <=> later
    in-out property <bool> playing: false;
    in-out property <bool> shuffle: false;
    in-out property <bool> repeat: false;
    in-out property <float> volume: 1.0;   //0..1

    callback toggle-play();
    callback previous();
    callback next();
    callback seek(float);              //seconds
    callback volume-changed(float);    //0..1
    callback add-clicked();

    //panels next to the volume bar, tinted pink while open
    in-out property <bool> lyrics-open: false;
    in-out property <bool> queue-open: false;
    in-out property <bool> fullscreen: false;   //bind to the window with <=>
    callback lyrics-clicked();
    callback queue-clicked();
    callback fullscreen-clicked();

    pure function format-time(t: float) -> string {
        return Math.floor(t / 60) + ":"
            + (Math.mod(Math.floor(t), 60) < 10 ? "0" : "")
            + Math.mod(Math.floor(t), 60);
    }

    VerticalLayout {

        //spacer rectangle to take up all extra space and push everything down
        Rectangle { }

        //play_bar_container stays locked at the bottom
        play_bar_container := Rectangle {
            width: 100%;
            height: Theme.player-bar-height;
            background: Theme.primary;
            border-width: 1px;
            border-radius: 12px;
            border-color: Theme.accent;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 24px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 12px;

                //album art, song title, and artist
                Rectangle {
                    width: 30%;
                    min-width: 270px;

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 80px;
                                height: 80px;
                                border-radius: self.width / 2;
                                clip: true;
                                background: @linear-gradient(135deg, Theme.cover-start 0%, Theme.cover-end 100%);

                                Image {
                                    source: root.cover-art;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: root.title;
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.artist;
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: self.width / 2;
                                border-width: 1px;
                                border-color: Theme.text-muted;

                                add-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.add-clicked(); }
                                }
                                Image {
                                    source: @image-url("../icons/plus.svg");
                                    colorize: Theme.icon-dim  ;
                                    width: 16px;
                                    height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    opacity: add-touch.has-hover ? 1.0 : 0.85;
                                }
                            }
                        }
                    }
                }

                //shuffle/prev/play/next/repeat and seek bar
                Rectangle {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;

                        HorizontalLayout {
                            height: 52px;
                            alignment: center;
                            spacing: 20px;

                            //shuffle
                            IconButton {
                                icon: @image-url("../icons/shuffle.svg");
                                tint: root.shuffle ? Theme.pink : Theme.icon-dim;
                                clicked => { root.shuffle = !root.shuffle; }
                            }
                            //previous
                            IconButton {
                                icon: @image-url("../icons/prev.svg");
                                tint: Theme.text-primary;
                                clicked => { root.previous(); }
                            }

                            //big white play/pause button
                            Rectangle {
                                width: 52px;
                                height: 52px;
                                border-radius: self.width / 2;
                                background: play-touch.has-hover ? Theme.play-button-hover : Theme.play-button;
                                drop-shadow-color: Theme.shadow;
                                drop-shadow-blur: 8px;
                                drop-shadow-offset-y: 2px;

                                play-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.playing = !root.playing;
                                        root.toggle-play();
                                    }
                                }
                                Image {
                                    source: root.playing
                                        ? @image-url("../icons/pause.svg")
                                        : @image-url("../icons/play.svg");
                                    width: 24px;
                                    height: 24px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            //next
                            IconButton {
                                icon: @image-url("../icons/next.svg");
                                tint: Theme.text-primary;
                                clicked => { root.next(); }
                            }
                            //repeat
                            IconButton {
                                icon: @image-url("../icons/repeat.svg");
                                tint: root.repeat ? Theme.pink : Theme.icon-dim;
                                clicked => { root.repeat = !root.repeat; }
                            }
                        }

                        //seekbar
                        HorizontalLayout {
                            height: 20px;
                            spacing: 10px;

                            Text {
                                width: 40px;
                                text: root.format-time(root.position);
                                color: Theme.text-muted;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            BarSlider {
                                horizontal-stretch: 1;
                                maximum: root.duration;
                                value: root.position;
                                released(v) => { root.seek(v); }
                            }
                            Text {
                                width: 40px;
                                text: root.format-time(root.duration);
                                color: Theme.text-muted;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                //lyrics/queue/fullscreen buttons sit above the volume bar
                Rectangle {
                    width: 22%;
                    min-width: 150px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;

                        //both rows are centered so the buttons line up over the volume bar
                        HorizontalLayout {
                            height: 34px;
                            alignment: center;
                            spacing: 6px;

                            IconButton {
                                icon: @image-url("../icons/lyrics.svg");
                                glyph: 20px;
                                tint: root.lyrics-open ? Theme.pink : Theme.icon-dim;
                                clicked => {
                                    root.lyrics-open = !root.lyrics-open;
                                    root.lyrics-clicked();
                                }
                            }
                            IconButton {
                                icon: @image-url("../icons/queue.svg");
                                glyph: 20px;
                                tint: root.queue-open ? Theme.pink : Theme.icon-dim;
                                clicked => {
                                    root.queue-open = !root.queue-open;
                                    root.queue-clicked();
                                }
                            }
                            IconButton {
                                icon: root.fullscreen
                                    ? @image-url("../icons/fullscreen-exit.svg")
                                    : @image-url("../icons/fullscreen.svg");
                                glyph: 20px;
                                tint: root.fullscreen ? Theme.pink : Theme.icon-dim;
                                clicked => {
                                    root.fullscreen = !root.fullscreen;
                                    root.fullscreen-clicked();
                                }
                            }
                        }

                        //volume
                        HorizontalLayout {
                            height: 34px;
                            alignment: center;
                            spacing: 1px;

                            IconButton {
                                icon: @image-url("../icons/volume.svg");
                                glyph: 20px;
                                tint: Theme.icon-dim;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 80px;
                                max-width: 130px;

                                BarSlider {
                                    width: 100%;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;
                                    maximum: 1;
                                    value: root.volume;
                                    fill: @linear-gradient(90deg, Theme.coral-light 0%, Theme.coral 100%);
                                    knob: Theme.coral;
                                    changed(v) => {
                                        root.volume = v;
                                        root.volume-changed(v);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
