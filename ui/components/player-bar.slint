import { Theme } from "../theme.slint";
import { BarSlider } from "bar-slider.slint";

//small icon button, only the icon area is clickable
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> glyph: 22px;
    in property <color> tint: Theme.icon-dim;
    callback clicked();

    width: root.glyph + 14px;

    Rectangle {
        width: root.glyph + 14px;
        height: root.glyph + 14px;
        y: (parent.height - self.height) / 2;

        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }

        Image {
            source: root.icon;
            colorize: root.tint;
            width: root.glyph;
            height: root.glyph;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            opacity: touch.has-hover ? 1.0 : 0.85;
        }
    }
}

    export component PlayerBar inherits Rectangle {
    //fill available parent space
    width: 100%;
    height: 100%;

    //track info
    in property <string> title: "Slow Tide Home";
    in property <string> artist: "Marlo Vey";
    in property <image> cover-art;      //empty -> pink gradient circle

    //playback state, in seconds
    in property <float> position: 32;
    in property <float> duration: 214;

    //two-way so they work standalone and can be bound with <=> later
    in-out property <bool> playing: false;
    in-out property <bool> shuffle: false;
    in-out property <bool> repeat: false;
    in-out property <float> volume: 1.0;   //0..1

    callback toggle-play();
    callback previous();
    callback next();
    callback seek(float);              //seconds
    callback volume-changed(float);    //0..1
    callback add-clicked();

    pure function format-time(t: float) -> string {
        return Math.floor(t / 60) + ":"
            + (Math.mod(Math.floor(t), 60) < 10 ? "0" : "")
            + Math.mod(Math.floor(t), 60);
    }

    VerticalLayout {

        //spacer rectangle to take up all extra space and push everything down
        Rectangle { }

        //play_bar_container stays locked at the bottom
        play_bar_container := Rectangle {
            width: 100%;
            height: 120px;
            background: Theme.primary;
            border-width: 1px;
            border-radius: 12px;
            border-color: Theme.accent;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 24px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 12px;

                //album art, song title, and artist
                Rectangle {
                    width: 26%;

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 80px;
                                height: 80px;
                                border-radius: self.width / 2;
                                clip: true;
                                background: @linear-gradient(135deg, #ff9cc2 0%, #ff4fa3 100%);

                                Image {
                                    source: root.cover-art;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: root.title;
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.artist;
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: self.width / 2;
                                border-width: 1px;
                                border-color: Theme.text-muted;

                                add-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.add-clicked(); }
                                }
                                Image {
                                    source: @image-url("../icons/plus.svg");
                                    colorize: Theme.text-muted;
                                    width: 16px;
                                    height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    opacity: add-touch.has-hover ? 1.0 : 0.85;
                                }
                            }
                        }
                    }
                }

                //shuffle/prev/play/next/repeat and seek bar
                Rectangle {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;

                        HorizontalLayout {
                            height: 52px;
                            alignment: center;
                            spacing: 26px;

                            IconButton {
                                icon: @image-url("../icons/shuffle.svg");
                                tint: root.shuffle ? Theme.pink : Theme.icon-dim;
                                clicked => { root.shuffle = !root.shuffle; }
                            }
                            IconButton {
                                icon: @image-url("../icons/prev.svg");
                                tint: Theme.text-primary;
                                clicked => { root.previous(); }
                            }

                            //big white play/pause button
                            Rectangle {
                                width: 52px;
                                height: 52px;
                                border-radius: self.width / 2;
                                background: play-touch.has-hover ? #ffffff : #f4f0fa;
                                drop-shadow-color: #00000066;
                                drop-shadow-blur: 8px;
                                drop-shadow-offset-y: 2px;

                                play-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.playing = !root.playing;
                                        root.toggle-play();
                                    }
                                }
                                Image {
                                    source: root.playing
                                        ? @image-url("../icons/pause.svg")
                                        : @image-url("../icons/play.svg");
                                    width: 24px;
                                    height: 24px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            IconButton {
                                icon: @image-url("../icons/next.svg");
                                tint: Theme.text-primary;
                                clicked => { root.next(); }
                            }
                            IconButton {
                                icon: @image-url("../icons/repeat.svg");
                                tint: root.repeat ? Theme.pink : Theme.icon-dim;
                                clicked => { root.repeat = !root.repeat; }
                            }
                        }

                        HorizontalLayout {
                            height: 20px;
                            spacing: 10px;

                            Text {
                                width: 40px;
                                text: root.format-time(root.position);
                                color: Theme.text-muted;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            BarSlider {
                                horizontal-stretch: 1;
                                maximum: root.duration;
                                value: root.position;
                                released(v) => { root.seek(v); }
                            }
                            Text {
                                width: 40px;
                                text: root.format-time(root.duration);
                                color: Theme.text-muted;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                //volume
                Rectangle {
                    width: 22%;

                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;

                        IconButton {
                            icon: @image-url("../icons/volume.svg");
                            glyph: 20px;
                            tint: Theme.text-muted;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 100px;
                            max-width: 130px;

                            BarSlider {
                                width: 100%;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                maximum: 1;
                                value: root.volume;
                                fill: @linear-gradient(90deg, #f7a4b4 0%, #ff7b72 100%);
                                knob: Theme.coral;
                                changed(v) => {
                                    root.volume = v;
                                    root.volume-changed(v);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
