import { Theme } from "../theme.slint";
import { PageScroll } from "page-scroll.slint";
import { CoverArt } from "cover-art.slint";
import { SearchField } from "search-field.slint";
import { SongInfo, SongRow } from "song-row.slint";
import { SongTableHeader } from "song-table-header.slint";
import { SortMenu } from "sort-menu.slint";
import { MenuPanel, MenuRow, MenuDivider } from "menu.slint";
import { AppState } from "../state.slint";

//shared layout of the Songs, Favorites, Recordings and Playlist pages
export component LibraryPage inherits Rectangle {
    //heading
    in property <string> page-title;
    in property <string> name;
    in property <string> subtitle;
    in property <bool> banner: false;             //artist style: one tall banner with the name on it, instead of the title + band
    in property <image> banner-art;               //picture on the banner, empty = gradient
    in property <bool> show-rename: false;        //pencil next to the name (playlists)
    in property <image> header-art;               //empty = gradient
    in property <image> header-icon;              //white icon drawn on the gradient
    in property <bool> header-show-icon: true;
    in property <bool> header-hover: false;       //hover effect on the header art (playlist page)
    in property <image> header-hover-icon;        //shown over the dimmed art while hovered

    //toolbar
    in property <bool> show-search: true;
    in property <string> search-placeholder: "Search";
    in property <bool> show-play: true;           //round play button + shuffle
    in property <string> action-label;            //e.g. "Start Recording", empty = no button
    in property <image> action-icon;
    in property <[string]> sort-options: ["Recently added", "Title", "Artist", "Length"];
    in-out property <int> sort-index: 1;              //pages open sorted by title
    in property <bool> show-album-column: true;   //false for recordings: a voice memo has no album
    in property <bool> select-enabled: true;      //the "select songs" button
    in property <bool> links: true;               //artist and album names in the rows are clickable
    in-out property <string> search-text;

    //list
    in property <[SongInfo]> songs;
    in property <string> length-label: "Length";
    in property <image> row-icon;                 //icon on every row's art (recordings)
    in property <bool> row-show-icon: false;
    in property <string> empty-text;
    in property <string> empty-link;              //underlined and clickable, right after empty-text
    in property <string> list-id: "songs";        //page name handed to the row menus: songs, favorites, recordings, playlist, artist
    in property <bool> show-list-menu: false;     //"..." next to shuffle with rename / cover / delete (playlists)

    callback song-clicked(int);
    callback play-clicked();
    callback shuffle-clicked();
    callback action-clicked();
    callback search-edited(string);
    callback sort-changed(int);
    callback empty-link-clicked();
    callback header-clicked();
    callback rename-clicked();                    //the pencil next to the name
    callback song-action(int, string);            //"..." menu of row i, see song-menu.slint
    callback list-action(string);                 //"rename", "cover" or "delete" from the list "..." menu                    //click on the header art (only when header-hover is on)

    property <bool> compact: root.width < Theme.bp-date;
    property <length> pad: root.compact ? 20px : 36px;
    property <length> art-size: root.compact ? 88px : 112px;
    property <bool> show-album: root.show-album-column && root.width >= Theme.bp-album;
    property <bool> show-date: root.width >= Theme.bp-date;
    property <length> search-w: Math.min(300px, root.width * 0.4);
    property <bool> has-search: root.show-search && root.width >= 480px;   //only a really tiny page drops the search box
    property <bool> searching: root.search-text != "";

    //Only the rows that are in view (and a few around them) are made, not one per song. A library of thousands of
    //songs would otherwise make thousands of rows, and their pictures, every time the page opens.
    property <length> row-pitch: Theme.row-height + 2px;
    property <length> list-top: table.y + list-area.y;                  //where the first row starts inside the scrolled content
    property <int> window-rows: Math.min(root.songs.length, Math.ceil(root.height / root.row-pitch) + 8);
    property <int> first-row: Math.min(
        Math.max(0, root.songs.length - root.window-rows),
        Math.max(0, Math.floor((scroller.scroll-y - root.list-top) / root.row-pitch) - 3));

    function row-clicked(i: int, ctrl: bool, shift: bool) {
        if (AppState.select-mode || ctrl || shift) {
            AppState.row-selected(root.list-id, i, ctrl, shift);
        } else {
            root.song-clicked(i);
        }
    }

    //entries of the selection menu
    function selection-act(id: string) {
        AppState.selection-action(root.list-id, id);
    }

    scroller := PageScroll {
        VerticalLayout {
            spacing: 0px;

            //artist banner
            if root.banner : Rectangle {
                height: Theme.banner-height;
                background: Theme.art-gradient;
                clip: true;

                Image {
                    source: root.banner-art;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
                //darkens the bottom so the name stays readable on any picture
                Rectangle {
                    y: parent.height - 90px;
                    height: 90px;
                    background: @linear-gradient(180deg, #00000000 0%, #00000070 100%);
                }
                Text {
                    x: root.pad;
                    y: parent.height - 64px;
                    width: parent.width - 2 * root.pad;
                    height: 40px;
                    text: root.name;
                    color: Theme.text-primary;
                    font-size: root.compact ? 28px : 36px;
                    font-weight: 800;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    x: root.pad;
                    y: parent.height - 26px;
                    width: parent.width - 2 * root.pad;
                    height: 18px;
                    text: root.subtitle;
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 700;
                    overflow: elide;
                }
            }

            //page title
            if !root.banner : Rectangle {
                height: root.compact ? 76px : 96px;

                Text {
                    x: root.pad;
                    width: parent.width - 2 * root.pad;
                    height: parent.height;
                    text: root.page-title;
                    color: Theme.text-primary;
                    font-size: root.compact ? 34px : 44px;
                    font-weight: 800;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            //band: cover, name, summary and search
            if !root.banner : Rectangle {
                height: root.art-size + 24px;
                background: Theme.header-band;

                cover := CoverArt {
                    x: root.pad;
                    y: (parent.height - self.height) / 2;
                    width: root.art-size;
                    height: root.art-size;
                    art: root.header-art;
                    icon: root.header-icon;
                    show-icon: root.header-show-icon;
                    hovered: root.header-hover && cover-touch.has-hover;
                    hover-icon: root.header-hover-icon;
                }

                //reports hover for the cover and, on pages with header-hover, handles clicks on it
                cover-touch := TouchArea {
                    mouse-cursor: root.header-hover ? MouseCursor.pointer : MouseCursor.default;
                    clicked => { if (root.header-hover) { root.header-clicked(); } }
                    x: cover.x;
                    y: cover.y;
                    width: cover.width;
                    height: cover.height;
                }

                VerticalLayout {
                    x: cover.x + cover.width + 20px;
                    width: max(0px, parent.width - self.x - root.pad - (root.has-search ? root.search-w + 16px : 0px));
                    height: parent.height;
                    alignment: center;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: root.name;
                            color: Theme.text-primary;
                            font-size: root.compact ? 24px : 32px;
                            font-weight: 800;
                            overflow: elide;
                        }

                        //pencil: rename the playlist
                        if root.show-rename : Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: self.width / 2;
                            background: rename-touch.has-hover ? Theme.nav-hover : transparent;

                            rename-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.rename-clicked(); }
                            }
                            Image {
                                source: @image-url("../icons/edit.svg");
                                colorize: rename-touch.has-hover ? Theme.text-primary : Theme.control-muted;
                                width: 18px;
                                height: 18px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    Text {
                        text: root.subtitle;
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 700;
                        overflow: elide;
                    }
                }

                if root.has-search : SearchField {
                    x: parent.width - self.width - root.pad;
                    y: (parent.height - self.height) / 2;
                    width: root.search-w;
                    height: 36px;
                    background: Theme.input-bg;
                    placeholder: root.search-placeholder;
                    text <=> root.search-text;
                    edited(t) => { root.search-edited(t); }
                }
            }

            //toolbar
            Rectangle {
                height: 76px;

                //play the whole list
                if root.show-play : Rectangle {
                    x: root.pad;
                    y: (parent.height - self.height) / 2;
                    width: 48px;
                    height: 48px;
                    border-radius: self.width / 2;
                    background: play-touch.has-hover ? Theme.play-button-hover : Theme.play-button;
                    animate background { duration: Theme.anim-fast; }

                    play-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.play-clicked(); }
                    }
                    Image {
                        source: @image-url("../icons/play.svg");
                        width: 24px;
                        height: 24px;
                        x: (parent.width - self.width) / 2 + 1px;
                        y: (parent.height - self.height) / 2;
                    }
                }

                //shuffle the whole list
                if root.show-play : Rectangle {
                    x: root.pad + 48px + 12px;
                    y: (parent.height - self.height) / 2;
                    width: 44px;
                    height: 44px;
                    border-radius: self.width / 2;
                    background: shuffle-touch.has-hover ? Theme.nav-hover : transparent;

                    shuffle-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.shuffle-clicked(); }
                    }
                    Image {
                        source: @image-url("../icons/shuffle.svg");
                        colorize: shuffle-touch.has-hover ? Theme.text-primary : Theme.control-muted;
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                //action button (Start Recording)
                if root.action-label != "" : Rectangle {
                    x: root.pad;
                    y: (parent.height - self.height) / 2;
                    height: 38px;
                    width: pill-row.preferred-width;
                    border-radius: 12px;
                    background: Theme.action-gradient;

                    //light wash on hover
                    Rectangle {
                        border-radius: parent.border-radius;
                        background: action-touch.has-hover ? #ffffff30 : transparent;
                        animate background { duration: Theme.anim-fast; }
                    }

                    action-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.action-clicked(); }
                    }
                    pill-row := HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;

                        Text {
                            text: root.action-label;
                            color: Theme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 20px;
                            Image {
                                source: root.action-icon;
                                colorize: Theme.text-primary;
                                width: 20px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                //playlist "..." menu: rename, change cover, delete
                if root.show-list-menu : Rectangle {
                    x: root.pad + 48px + 12px + 44px + 4px;
                    y: (parent.height - self.height) / 2;
                    width: 44px;
                    height: 44px;
                    border-radius: self.width / 2;
                    background: list-touch.has-hover ? Theme.nav-hover : transparent;

                    list-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { list-popup.show(); }
                    }
                    Image {
                        source: @image-url("../icons/more.svg");
                        colorize: list-touch.has-hover ? Theme.text-primary : Theme.control-muted;
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    list-popup := PopupWindow {
                        x: 0px;
                        y: parent.height + 4px;
                        width: 230px;
                        height: 3 * Theme.menu-row-height + 12px;
                        close-policy: PopupClosePolicy.close-on-click-outside;

                        MenuPanel {
                            MenuRow {
                                icon: @image-url("../icons/edit.svg");
                                label: "Rename playlist";
                                clicked => { root.list-action("rename"); list-popup.close(); }
                            }
                            MenuRow {
                                icon: @image-url("../icons/camera.svg");
                                label: "Change cover";
                                clicked => { root.list-action("cover"); list-popup.close(); }
                            }
                            MenuRow {
                                icon: @image-url("../icons/trash.svg");
                                label: "Delete playlist";
                                danger: true;
                                clicked => { root.list-action("delete"); list-popup.close(); }
                            }
                        }
                    }
                }

                //"select songs": tick boxes appear and the selection bar below opens the menu for all ticked songs
                if root.select-enabled && root.songs.length > 0 : Rectangle {
                    x: sort-menu.x - 48px;
                    y: (parent.height - self.height) / 2;
                    width: 44px;
                    height: 44px;
                    border-radius: self.width / 2;
                    background: AppState.select-mode ? Theme.nav-hover : (select-touch.has-hover ? Theme.nav-hover : transparent);

                    select-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { AppState.select-mode-toggled(!AppState.select-mode); }
                    }
                    Image {
                        source: @image-url("../icons/select.svg");
                        colorize: AppState.select-mode ? Theme.pink : (select-touch.has-hover ? Theme.text-primary : Theme.control-muted);
                        width: 26px;
                        height: 26px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                sort-menu := SortMenu {
                    x: parent.width - self.width - root.pad;
                    y: (parent.height - self.height) / 2;
                    options: root.sort-options;
                    selected <=> root.sort-index;
                    chosen(i) => { root.sort-changed(i); }
                }
            }

            //selection bar: how many songs are ticked and the menu that works on all of them
            if AppState.select-mode : Rectangle {
                height: 52px;
                background: Theme.header-band;

                Text {
                    x: root.pad;
                    width: max(0px, parent.width - 2 * root.pad - 330px);
                    height: parent.height;
                    text: AppState.selected-count == 0 ? "Tick the songs you want" : "\{AppState.selected-count} selected";
                    color: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 800;
                    vertical-alignment: center;
                    overflow: elide;
                }

                HorizontalLayout {
                    x: parent.width - self.width - root.pad;
                    width: min(330px, parent.width - 2 * root.pad);
                    height: parent.height;
                    alignment: end;
                    spacing: 8px;
                    padding-top: 8px;
                    padding-bottom: 8px;

                    //select every row of the page
                    Rectangle {
                        width: 84px;
                        border-radius: 10px;
                        background: all-touch.has-hover ? Theme.nav-hover : transparent;
                        all-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { AppState.select-all(root.list-id); }
                        }
                        Text {
                            text: "Select all";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    //the menu for every ticked song
                    Rectangle {
                        width: 100px;
                        border-radius: 10px;
                        background: AppState.selected-count == 0 ? #ffffff10 : Theme.action-gradient;
                        opacity: AppState.selected-count == 0 ? 0.5 : 1.0;

                        act-touch := TouchArea {
                            enabled: AppState.selected-count > 0;
                            mouse-cursor: AppState.selected-count > 0 ? MouseCursor.pointer : MouseCursor.default;
                            clicked => { selection-popup.show(); }
                        }
                        Text {
                            text: "Actions";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        selection-popup := PopupWindow {
                            x: parent.width - self.width;
                            y: parent.height + 4px;
                            width: 250px;
                            height: root.list-id == "recordings"
                                ? 2 * Theme.menu-row-height + 9px + 12px
                                : (root.list-id == "playlist" ? 8 : 7) * Theme.menu-row-height + 3 * 9px + 12px;
                            close-policy: PopupClosePolicy.close-on-click-outside;

                            MenuPanel {
                                MenuRow {
                                    icon: @image-url("../icons/play.svg");
                                    label: "Play";
                                    clicked => { root.selection-act("play"); selection-popup.close(); }
                                }
                                MenuDivider { }
                                if root.list-id != "recordings" : MenuRow {
                                    icon: @image-url("../icons/queue-add.svg");
                                    label: "Add to queue";
                                    clicked => { root.selection-act("queue-add"); selection-popup.close(); }
                                }
                                if root.list-id != "recordings" : MenuRow {
                                    icon: @image-url("../icons/queue-remove.svg");
                                    label: "Remove from queue";
                                    clicked => { root.selection-act("queue-remove"); selection-popup.close(); }
                                }
                                if root.list-id != "recordings" : MenuDivider { }
                                if root.list-id != "recordings" : MenuRow {
                                    icon: @image-url("../icons/playlist-add.svg");
                                    label: "Add to playlist";
                                    clicked => { root.selection-act("add-playlist"); selection-popup.close(); }
                                }
                                if root.list-id != "recordings" : MenuRow {
                                    icon: @image-url("../icons/heart.svg");
                                    label: "Add to Favorites";
                                    clicked => { root.selection-act("favorite"); selection-popup.close(); }
                                }
                                if root.list-id != "recordings" : MenuRow {
                                    icon: @image-url("../icons/heart-outline.svg");
                                    label: "Remove from Favorites";
                                    clicked => { root.selection-act("unfavorite"); selection-popup.close(); }
                                }
                                if root.list-id != "recordings" : MenuDivider { }
                                if root.list-id == "playlist" : MenuRow {
                                    icon: @image-url("../icons/close.svg");
                                    label: "Remove from this playlist";
                                    clicked => { root.selection-act("remove-from-playlist"); selection-popup.close(); }
                                }
                                MenuRow {
                                    icon: @image-url("../icons/trash.svg");
                                    label: root.list-id == "recordings" ? "Delete recordings" : "Remove from library";
                                    danger: true;
                                    clicked => { root.selection-act("delete"); selection-popup.close(); }
                                }
                            }
                        }
                    }

                    //leave selecting
                    Rectangle {
                        width: 64px;
                        border-radius: 10px;
                        background: done-touch.has-hover ? Theme.nav-hover : transparent;
                        done-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { AppState.select-mode-toggled(false); }
                        }
                        Text {
                            text: "Done";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            //table header, rows and the empty state
            table := VerticalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                spacing: 2px;

                SongTableHeader {
                    show-album: root.show-album;
                    show-date: root.show-date;
                    length-label: root.length-label;
                }

                if root.songs.length == 0 : Rectangle {
                    height: 64px;

                    HorizontalLayout {
                        x: 8px + Theme.col-index;
                        width: max(0px, parent.width - self.x - 8px);
                        alignment: start;

                        Text {
                            text: root.searching ? "No results for “\{root.search-text}”" : root.empty-text;
                            color: Theme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        if !root.searching && root.empty-link != "" : Rectangle {
                            width: link-text.preferred-width;

                            link-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.empty-link-clicked(); }
                            }
                            link-text := Text {
                                width: 100%;
                                height: 100%;
                                text: root.empty-link;
                                color: Theme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                y: parent.height / 2 + 10px;
                                height: 1.5px;
                                background: Theme.text-primary;
                            }
                        }
                    }
                }

                //the rows. This box is as tall as ALL the rows would be, but only the ones in view exist
                list-area := Rectangle {
                    height: root.songs.length * root.row-pitch;

                    for k in root.window-rows : SongRow {
                        property <int> idx: root.first-row + k;
                        y: self.idx * root.row-pitch;
                        width: parent.width;
                        index: self.idx;
                        song: root.songs[self.idx];
                        icon: root.row-icon;
                        show-icon: root.row-show-icon;
                        show-album: root.show-album;
                        show-date: root.show-date;
                        select-mode: AppState.select-mode;
                        links: root.links;
                        context: root.list-id;
                        clicked(ctrl, shift) => { root.row-clicked(self.idx, ctrl, shift); }
                        action(id) => { root.song-action(self.idx, id); }
                    }
                }
            }

            //breathing room at the bottom of the scroll area
            Rectangle { height: 40px; }
        }
    }
}
