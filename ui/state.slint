import { MockData } from "mock-data.slint";
import { TrackInfo } from "components/track-card.slint";
import { PlaylistInfo } from "components/playlist-item.slint";
import { NavSection } from "components/side-nav.slint";
import { SongInfo } from "components/song-row.slint";
import { PlaylistChoice } from "components/add-to-playlist.slint";
import { LyricLine } from "components/lyrics-panel.slint";
import { ArtistInfo } from "components/artist-tile.slint";
import { AlbumInfo } from "components/album-tile.slint";
import { RemovedInfo } from "components/removed-songs-dialog.slint";
import { RecordState } from "components/recorder-dialog.slint";
import { MusicFolderInfo } from "views/settings-view.slint";

//re-exported so app.slint can hand them to the C++ side
export { TrackInfo, PlaylistInfo, NavSection, SongInfo, PlaylistChoice, LyricLine, ArtistInfo, AlbumInfo, RemovedInfo, RecordState, MusicFolderInfo }

//the window in front of the page, if any. Only one at a time.
export enum DialogKind {
    none,
    new-playlist,       //asks for a name, then create-playlist
    rename-playlist,    //asks for a name, then rename-playlist
    delete-playlist,    //are you sure, then delete-playlist
    pick-playlist,      //"Add to playlist" for a song of a "..." menu
    removed-songs,      //the manager of songs removed from the library (Settings)
    delete-song,        //are you sure, then delete-song
    remove-folder,      //are you sure, then remove-music-folder
    recorder,           //Start Recording
    edit-account,       //Settings > Account > Edit
}

//AppState is the single connection point between the UI and the C++ backend.
//no other .slint file needs to be touched to connect the backend.
//every property starts out with a mock default from mock-data.slint. setting it from C++ replaces that default, and the callbacks that have mock handlers below are replaced the same way when the backend registers its own
export global AppState {
    // navigation 
    in-out property <NavSection> section: NavSection.home;
    in-out property <int> selected-playlist: -1;        //-1 = none

    // now playing (shown in the player bar) 
    in-out property <string> title: MockData.enabled ? MockData.now-title : "";
    in-out property <string> artist: MockData.enabled ? MockData.now-artist : "";
    in-out property <string> album;                     //album of the playing song, "" = none (shown next to the artist)
    in-out property <image> cover-art;                  //empty = gradient placeholder
    in-out property <float> position: MockData.enabled ? MockData.position : 0;   //seconds
    in-out property <float> duration: MockData.enabled ? MockData.now-duration : 0;   //seconds
    in-out property <bool> playing: false;
    in-out property <bool> shuffle: false;              //set by the backend
    in-out property <int> repeat-mode: 0;               //set by the backend: 0 = off, 1 = repeat all, 2 = repeat one
    in-out property <float> volume: 1.0;                //0..1
    in-out property <bool> lyrics-open: false;
    in-out property <bool> queue-open: false;
    in-out property <bool> fullscreen: false;           //bound to the window

    //top bar 
    in-out property <string> search-text;
    in-out property <string> profile-initial: MockData.enabled ? MockData.profile-initial : "";   //Slint cannot cut a string, so the backend supplies the letter
    in-out property <image> profile-picture;           //empty = gradient with the letter

    //library (sidebar) 
    in-out property <int> songs-count: MockData.enabled ? MockData.songs-count : 0;
    in-out property <int> favorites-count: MockData.enabled ? MockData.favorites-count : 0;
    in-out property <int> recordings-count: MockData.enabled ? MockData.recordings-count : 0;
    in-out property <int> albums-count: 0;
    in-out property <int> artists-count: 0;
    in-out property <[PlaylistInfo]> playlists: MockData.enabled ? MockData.playlists : [];

    //"Add to playlist" popup
    //playlists the current track can go into, those it is already in (saved: true) first
    in-out property <[PlaylistChoice]> playlist-choices: MockData.enabled ? MockData.playlist-choices : [];
    in-out property <bool> current-favorite;           //is the playing track a favorite
    in-out property <int> track-saved-in: MockData.enabled ? MockData.track-saved-in : 0;   //in how many playlists the playing track is, the + turns into a tick when this or current-favorite is set

    //lyrics popup (lyrics button in the player bar)
    in-out property <[LyricLine]> lyrics: MockData.enabled ? MockData.lyrics : [];     //lyrics of the playing song, empty = "No lyrics"
    in-out property <int> lyric-index: MockData.enabled ? MockData.lyric-index : -1;   //line being sung now, the backend moves it as the song plays, -1 = none yet

    //queue panel (queue button in the player bar)
    in-out property <[SongInfo]> queue-tracks: MockData.enabled ? MockData.queue-songs : [];       //whole queue in play order, the playing track included
    in-out property <int> queue-index: MockData.enabled ? MockData.index : 0;                     //position of the playing track in queue-tracks
    in-out property <string> queue-context: MockData.enabled ? MockData.queue-context : "";       //"Next from: ...", empty = just "Next up"
    in-out property <[SongInfo]> recently-played: MockData.enabled ? MockData.recently-played : [];   //newest first

    //home page lists
    in-out property <[TrackInfo]> recent: MockData.enabled && MockData.home-feed ? MockData.recent : [];
    in-out property <[TrackInfo]> most-played: MockData.enabled && MockData.home-feed ? MockData.most-played : [];
    in-out property <[TrackInfo]> recently-added: MockData.enabled && MockData.home-feed ? MockData.recently-added : [];

    //library pages
    in-out property <[SongInfo]> songs: MockData.enabled && MockData.library-feed ? MockData.songs : [];
    in-out property <float> songs-seconds: MockData.enabled && MockData.library-feed ? MockData.songs-seconds : 0;
    in-out property <[SongInfo]> favorites: MockData.enabled && MockData.library-feed ? MockData.favorites : [];
    in-out property <float> favorites-seconds: MockData.enabled && MockData.library-feed ? MockData.favorites-seconds : 0;
    in-out property <[SongInfo]> recordings: MockData.enabled && MockData.library-feed ? MockData.recordings : [];
    in-out property <[SongInfo]> playlist-songs: MockData.enabled && MockData.library-feed ? MockData.playlist-songs : [];   //songs of playlists[selected-playlist]
    in-out property <float> playlist-seconds: MockData.enabled && MockData.library-feed ? MockData.playlist-seconds : 0;

    //pages opened by "Show all" on the home page
    in-out property <[SongInfo]> recent-songs;                  //recent activity, newest first
    in-out property <float> recent-seconds;
    in-out property <[SongInfo]> most-played-songs;
    in-out property <float> most-played-seconds;
    in-out property <[SongInfo]> recently-added-songs;
    in-out property <float> recently-added-seconds;

    //artists page (the artist page itself is further down)
    in-out property <[ArtistInfo]> artists;

    //songs removed from the library on purpose, and what the settings page does about them
    in-out property <[RemovedInfo]> removed-songs;
    in-out property <bool> open-last-profile: true;             //open the profile that was used last when the app starts

    //albums page and album page
    in-out property <[AlbumInfo]> albums;
    in-out property <string> album-name;
    in-out property <string> album-subtitle;                    //the artist of the album
    in-out property <image> album-art;                          //empty = gradient banner
    in-out property <[SongInfo]> album-songs;
    in-out property <float> album-seconds;

    //selecting several songs
    in-out property <bool> select-mode;                         //tick boxes are showing
    in-out property <int> selected-count;
    in-out property <int> pending-count: 1;                     //songs the open "delete" window is about (more than one when it came from a selection)

    //true while the library is being looked through in the background
    in-out property <bool> scanning;

    //profile and settings pages
    in-out property <string> profile-name: MockData.enabled ? MockData.profile-name : "";
    in-out property <string> account-email;
    in-out property <[ArtistInfo]> top-artists: MockData.enabled ? MockData.top-artists : [];   //most played artists first
    in-out property <[SongInfo]> top-songs;                     //most played songs first (profile page)
    in-out property <string> storage-text;            //"3 folders, 128 songs"
    in-out property <[MusicFolderInfo]> music-folders: MockData.enabled ? MockData.music-folders : [];   //the folders the library reads, the default one first
    in-out property <string> folder-error;            //why a folder could not be added or removed, empty = no problem
    in-out property <[string]> languages: ["English"];
    in-out property <int> language-index: 0;
    in-out property <[string]> themes: ["Default"];
    in-out property <int> theme-index: 0;
    in-out property <bool> autoplay: false;

    //artist page: filled by the backend when artist-clicked fires
    in-out property <string> artist-name;
    in-out property <image> artist-art;               //empty = gradient banner
    in-out property <[SongInfo]> artist-songs: MockData.enabled && MockData.library-feed ? MockData.songs : [];
    in-out property <float> artist-seconds: MockData.enabled && MockData.library-feed ? MockData.songs-seconds : 0;

    //windows in front of the page (see DialogKind)
    in-out property <DialogKind> dialog: DialogKind.none;
    in-out property <string> dialog-text;             //text in the name box of the new / rename playlist window
    in-out property <string> dialog-error;            //red text in the open window, set by the backend when a callback says no (e.g. "That name is already used")
    in-out property <string> create-with: "";         //what a new playlist starts with: "" = nothing, "current" = the playing song, "song" = pending-list / pending-row
    in-out property <string> pending-list;            //song a menu action is about: the list ("songs", "favorites", "recordings", "playlist", "artist") and the row in it
    in-out property <int> pending-row;
    in-out property <string> pending-title;           //its title, for the windows
    in-out property <int> pending-playlist;           //playlist rename / delete is about, index into playlists
    in-out property <[PlaylistChoice]> song-playlist-choices;   //rows of the "Add to playlist" window for pending-list / pending-row

    //recorder window
    in-out property <RecordState> record-state: RecordState.idle;
    in-out property <float> record-seconds;           //length so far, the backend updates it while recording
    in-out property <float> record-level;             //0..1 loudness for the meter, the backend updates it while recording
    in-out property <string> record-error;            //"No microphone found" and the like
    in-out property <string> record-saved-name;       //file name shown once saved

    // player actions 
    //playing / volume are already updated when these fire, read them with get_xxx().
    //shuffle and repeat are not: the buttons only ask, the backend flips its mode and sets shuffle / repeat-mode
    callback toggle-play();
    callback previous();
    callback next();
    callback seek(float);                //seconds
    callback volume-changed(float);      //0..1
    callback shuffle-clicked();
    callback repeat-clicked();
    callback lyrics-toggled(bool);
    callback queue-toggled(bool);
    callback queue-track-clicked(int);   //a track under "Next from" in the queue panel, index into queue-tracks
    callback recent-track-clicked(int);  //a track in the "Recently played" tab, index into recently-played
    callback add-current-track();        //the + next to the song title, fired as the popup opens: refresh playlist-choices
    callback favorite-toggled(bool);     //"Add to Favorites" in the popup, true = now a favorite
    callback playlist-toggled(int);      //a playlist row in the popup, index into playlist-choices. Add/remove the track, then flip checked
    callback playlist-picker-search(string);   //"Find a playlist" box in the popup, filter playlist-choices and set them again

    //top bar actions
    callback search-changed(string);     //on every keystroke
    callback search-submitted(string);   //Enter pressed
    callback profile-clicked();

    //library and navigation actions
    callback section-changed(NavSection);
    callback playlist-clicked(int);      //index into playlists
    callback track-clicked(TrackInfo);   //a card on the home page
    callback show-all(string);           //"recent", "most-played" or "recently-added"

    //library page actions
    //the string says which list: "songs", "favorites", "recordings" or "playlist"
    callback song-clicked(string, int);          //row index in the list as it is shown right now
    callback play-list(string);                  //the big play button
    callback shuffle-list(string);
    callback list-search-changed(string, string);   //list, text. Filter the list and set it again
    callback list-sort-changed(string, int);     //list, index in the sort menu (0 = recently added, 1 = title, 2 = artist, 3 = length)
    callback edit-playlist-art(int);             //click on the open playlist's art, index into playlists
    callback remove-music-folder(int);           //the trash icon of a folder in the settings
    callback add-folder();                       //"add a new folder" in the empty Songs page, and "Add folder" in settings

    //song "..." menus. list is "songs", "favorites", "recordings", "playlist" or "artist", row is the row as shown right now
    //action is "play", "queue-add", "queue-remove", "favorite", "show-file" or "remove-from-playlist".
    //"add-playlist", "delete" and "view-artist" are handled by the screen first, see below
    //(with several songs ticked, the menu of a ticked row works on all of them: selection-action)
    callback song-menu-action(string, int, string);
    callback song-playlists-requested(string, int);     //"Add to playlist" opened: fill song-playlist-choices for this song
    callback song-playlist-toggled(int);                //row of song-playlist-choices: add or remove the song, then flip checked
    callback song-playlist-search(string);              //"Find a playlist" box of that window
    callback delete-song(string, int);                  //confirmed: remove the song from the library (recordings: delete the file too)

    //playlists: the + in the sidebar and the player bar's "New playlist" ask for a name first
    callback create-playlist(string, string) -> bool;   //name, create-with. true = created, the window closes. false = keep it open and set dialog-error
    callback rename-playlist(int, string) -> bool;      //index into playlists, new name. same true / false
    callback delete-playlist(int);                      //confirmed, index into playlists

    //selecting several songs. list is "songs", "favorites", "recordings", "playlist", "artist", "album", "recent", "most-played" or "recently-added"
    callback select-mode-toggled(bool);                 //the select button, true = tick boxes on. false also clears the ticks
    callback row-selected(string, int, bool, bool);     //list, row, ctrl held, shift held: tick or untick (see Selection)
    callback select-all(string);
    //an entry of the selection menu: "play", "queue-add", "queue-remove", "add-playlist", "favorite", "unfavorite", "remove-from-playlist" or "delete"
    callback selection-action(string, string);          //list, action. The program opens the windows itself for add-playlist and delete

    //profile page
    callback top-song-clicked(int);                     //a row of "Most played songs", index into top-songs

    //artists page
    callback artist-tile-clicked(int);                  //a tile of the Artists page, index into artists
    callback artists-search-changed(string);
    callback artists-sort-changed(int);                 //0 = name, 1 = most songs

    //removed songs manager and launch settings (Settings page)
    callback restore-removed(int);                      //put one song of removed-songs back into the library
    callback restore-all-removed();
    callback open-last-profile-toggled(bool);

    //albums page
    callback album-clicked(int);                        //a tile of the Albums page, index into albums
    callback albums-search-changed(string);
    callback albums-sort-changed(int);                  //0 = name, 1 = artist, 2 = recently added

    //artist page
    callback artist-clicked(string);                    //name: fill artist-songs / artist-seconds / artist-art. The screen already switched to the artist page

    //recorder window
    callback begin-recording(string);                   //Start: the name typed, "" = pick one. Set record-state to recording, or record-error
    callback stop-recording();                          //Stop and save: set record-state to saved and record-saved-name
    callback cancel-recording();                        //Discard: delete the file, set record-state to idle

    //profile and settings
    callback change-profile-picture();                  //the backend opens a file picker and sets profile-picture
    callback account-saved(string, string, string, string) -> bool;   //username, email, current password, new password. true = saved, the window closes
    callback language-changed(int);
    callback theme-changed(int);
    callback autoplay-toggled(bool);

    //mock behaviour, replaced when the backend registers its own handler
    shuffle-clicked => { if (MockData.enabled) { shuffle = !shuffle; } }
    repeat-clicked => { if (MockData.enabled) { repeat-mode = Math.mod(repeat-mode + 1, 3); } }
    create-playlist(name, with) => { return true; }
    rename-playlist(i, name) => { return true; }
    account-saved(user, email, current, new-password) => { return true; }
    begin-recording(name) => {
        if (MockData.enabled) {
            record-seconds = 0;
            record-state = RecordState.recording;
        }
    }
    stop-recording => {
        if (MockData.enabled) {
            record-saved-name = "rec_1.mp3";
            record-state = RecordState.saved;
        }
    }
    cancel-recording => { record-state = RecordState.idle; }
    next => { if (MockData.enabled) { MockData.next(); } }
    playlist-toggled(i) => {
        if (MockData.enabled) {
            playlist-choices[i].checked = !playlist-choices[i].checked;
            playlist-choices[i].count += playlist-choices[i].checked ? 1 : -1;
            track-saved-in += playlist-choices[i].checked ? 1 : -1;
        }
    }
    previous => { if (MockData.enabled) { MockData.previous(); } }
    queue-track-clicked(i) => {
        if (MockData.enabled) {
            MockData.load(i);
            playing = true;
        }
    }
    recent-track-clicked(i) => {
        if (MockData.enabled) {
            MockData.play-song(recently-played[i]);
            playing = true;
        }
    }
    seek(s) => { if (MockData.enabled) { MockData.seek(s); } }
    song-clicked(list, i) => {
        if (MockData.enabled) {
            if (list == "songs") { MockData.play-song(songs[i]); }
            else if (list == "favorites") { MockData.play-song(favorites[i]); }
            else if (list == "recordings") { MockData.play-song(recordings[i]); }
            else { MockData.play-song(playlist-songs[i]); }
            playing = true;
        }
    }
    track-clicked(t) => {
        if (MockData.enabled) {
            MockData.play-card(t);
            playing = true;
        }
    }
}
