import { TrackInfo } from "components/track-card.slint";
import { PlaylistInfo } from "components/playlist-item.slint";
import { SongInfo } from "components/song-row.slint";
import { ProfileInfo } from "components/login-card.slint";
import { PlaylistChoice } from "components/add-to-playlist.slint";

//one entry of the fake play queue
export struct MockTrack {
    title: string,
    artist: string,
    duration: float,   //seconds
}

//all placeholder content lives here and nowhere else 
//state.slint (AppState) reads from this file as the *default* value of each property.
//when the C++ backend sets a property, that default is replaced automatically, so mock and real data can be mixed while the backend is built up piece by piece.
export global MockData {
    in-out property <bool> enabled: true;
    in-out property <bool> home-feed: true;
    in-out property <bool> library-feed: true;

    //profile
    out property <string> profile-initial: "A";     //first letter of the profile name

    //saved profiles on the login screen (no picture = gradient with the profile icon)
    out property <[ProfileInfo]> profiles: [
        { name: "Alex Morgan" },
        { name: "Jamie Rivera" },
        { name: "Sam Okafor" },
    ];

    //library
    out property <int> songs-count: 128;
    out property <int> favorites-count: 24;
    out property <int> recordings-count: 6;

    out property <[PlaylistInfo]> playlists: [
        { title: "Late Night Drive" },
        { title: "Morning Run" },
        { title: "Focus Flow" },
        { title: "Road Trip" },
        { title: "Rainy Day" },
    ];

    //"Add to playlist" popup, playlists that already have the track come first
    out property <[PlaylistChoice]> playlist-choices: [
        { title: "Late Night Drive", count: 42, saved: true, checked: true },
        { title: "Focus Flow", count: 18, saved: true, checked: true },
        { title: "Morning Run", count: 29 },
        { title: "Road Trip", count: 57 },
        { title: "Rainy Day", count: 12 },
        { title: "Gym Mix", count: 33 },
        { title: "Sunday Chill", count: 21 },
        { title: "Throwback Hits", count: 64 },
    ];

    out property <int> track-saved-in: 2;      //how many of the playlists above already have the track (the saved ones)

    //home page
    out property <[TrackInfo]> recent: [
        { title: "Slow Tide Home", subtitle: "Marlo Vey" },
        { title: "Paper Lanterns", subtitle: "Hollis & Reed" },
        { title: "Northbound", subtitle: "The Quiet Fields" },
        { title: "Glass Hours", subtitle: "Ines Alder" },
        { title: "Soft Static", subtitle: "Marlo Vey" },
        { title: "Low Orbit", subtitle: "Juno Park" },
    ];

    out property <[TrackInfo]> most-played: [
        { title: "Slow Tide Home", subtitle: "Marlo Vey" },
        { title: "Glass Hours", subtitle: "Ines Alder" },
        { title: "Northbound", subtitle: "The Quiet Fields" },
        { title: "Evergreen", subtitle: "Hollis & Reed" },
        { title: "Low Orbit", subtitle: "Juno Park" },
        { title: "Paper Lanterns", subtitle: "Hollis & Reed" },
    ];

    out property <[TrackInfo]> recently-added: [
        { title: "Harbor Lights", subtitle: "Ines Alder" },
        { title: "Quiet Rooms", subtitle: "Juno Park" },
        { title: "Amber Season", subtitle: "The Quiet Fields" },
        { title: "Static Bloom", subtitle: "Marlo Vey" },
        { title: "Wide Open", subtitle: "Hollis & Reed" },
        { title: "Late Trains", subtitle: "Juno Park" },
    ];

    //library pages
    out property <[SongInfo]> songs: [
        { title: "Slow Tide Home", artist: "Marlo Vey", album: "Tidal Hours", date-added: "yesterday", length: "3:22" },
        { title: "Paper Lanterns", artist: "Hollis & Reed", album: "", date-added: "2 weeks", length: "3:07" },
        { title: "Northbound", artist: "The Quiet Fields", album: "Long Way Round", date-added: "2 weeks", length: "4:02" },
        { title: "Glass Hours", artist: "Ines Alder", album: "", date-added: "4 weeks", length: "3:23" },
        { title: "Soft Static", artist: "Marlo Vey", album: "Tidal Hours", date-added: "1 month", length: "2:58" },
        { title: "Low Orbit", artist: "Juno Park", album: "Low Orbit", date-added: "2 months", length: "2:51" },
        { title: "Evergreen", artist: "Hollis & Reed", album: "", date-added: "3 months", length: "3:44" },
        { title: "Harbor Lights", artist: "Ines Alder", album: "", date-added: "3 months", length: "3:36" },
    ];
    out property <float> songs-seconds: 1587;

    out property <[SongInfo]> favorites: [
        { title: "Slow Tide Home", artist: "Marlo Vey", album: "Tidal Hours", date-added: "yesterday", length: "3:22" },
        { title: "Paper Lanterns", artist: "Hollis & Reed", album: "", date-added: "2 weeks", length: "3:07" },
        { title: "Glass Hours", artist: "Ines Alder", album: "", date-added: "4 weeks", length: "3:23" },
    ];
    out property <float> favorites-seconds: 592;

    out property <[SongInfo]> recordings: [
        { title: "Recording 3", artist: "Voice memo", album: "", date-added: "today", length: "0:48" },
        { title: "Guitar idea", artist: "Voice memo", album: "", date-added: "3 days", length: "2:15" },
        { title: "Recording 1", artist: "Voice memo", album: "", date-added: "1 month", length: "1:03" },
    ];

    out property <[SongInfo]> playlist-songs: [
        { title: "Northbound", artist: "The Quiet Fields", album: "Long Way Round", date-added: "yesterday", length: "4:02" },
        { title: "Low Orbit", artist: "Juno Park", album: "Low Orbit", date-added: "3 days", length: "2:51" },
        { title: "Evergreen", artist: "Hollis & Reed", album: "", date-added: "1 week", length: "3:44" },
        { title: "Soft Static", artist: "Marlo Vey", album: "Tidal Hours", date-added: "2 weeks", length: "2:58" },
    ];
    out property <float> playlist-seconds: 835;

    //fake player
    out property <[MockTrack]> queue: [
        { title: "Slow Tide Home", artist: "Marlo Vey", duration: 214 },
        { title: "Paper Lanterns", artist: "Hollis & Reed", duration: 187 },
        { title: "Northbound", artist: "The Quiet Fields", duration: 242 },
        { title: "Glass Hours", artist: "Ines Alder", duration: 203 },
        { title: "Low Orbit", artist: "Juno Park", duration: 171 },
    ];

    in-out property <int> index: 0;
    in-out property <string> now-title: queue[0].title;
    in-out property <string> now-artist: queue[0].artist;
    in-out property <float> now-duration: queue[0].duration;
    in-out property <float> position: 32;

    public function load(i: int) {
        index = Math.mod(i + queue.length, queue.length);
        now-title = queue[index].title;
        now-artist = queue[index].artist;
        now-duration = queue[index].duration;
        position = 0;
    }
    public function next() { load(index + 1); }
    public function previous() {
        if (position > 3) { position = 0; } else { load(index - 1); }
    }
    public function seek(seconds: float) { position = seconds; }
    //pretend to play a card that was clicked on the home page
    public function play-card(t: TrackInfo) {
        now-title = t.title;
        now-artist = t.subtitle;
        now-duration = 200;
        position = 0;
    }
    //pretend to play a song that was clicked in one of the library lists
    public function play-song(t: SongInfo) {
        now-title = t.title;
        now-artist = t.artist;
        now-duration = 200;
        position = 0;
    }
    //called by MockBackend while "playing"
    public function tick(dt: float) {
        position += dt;
        if (position >= now-duration) { next(); }
    }
}
